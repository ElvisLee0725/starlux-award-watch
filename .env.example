# Copy to .env and fill in. Never commit .env.

# --- Pushover (default alert channel) ---
PUSHOVER_API_TOKEN=your_application_token   # pushover.net -> Create an Application/API Token
PUSHOVER_USER_KEY=your_user_key             # shown on the pushover.net dashboard
# PUSHOVER_DEVICE=iphone                    # optional: target one device

# --- Twilio (only if alerts.channel: sms) ---
# TWILIO_ACCOUNT_SID=ACxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# TWILIO_AUTH_TOKEN=your_auth_token
# TWILIO_FROM_NUMBER=+1XXXXXXXXXX
# ALERT_TO_NUMBER=+1XXXXXXXXXX

# --- optional ---
# STARLUX_CONFIG=config.local.yaml
